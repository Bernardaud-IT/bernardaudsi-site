# Configuration Apache pour l'hébergement OVH Web Cloud (mutualisé).
# À déposer à la racine du site (dossier www/) avec le contenu de dist/. Voir docs/DEPLOIEMENT.md.
# Toute règle de ce fichier est à valider sur l'hébergement réel avant la mise en ligne.
#
# Ce fichier convient aussi à un aperçu sur un sous-domaine : la redirection HTTPS suit le nom de domaine demandé,
# et la seule règle propre à la production (www vers bernardaudsi.com) ne concerne que www.bernardaudsi.com.

DirectoryIndex index.html
ErrorDocument 404 /404.html
# Pas de « Options -Indexes » : sur certaines offres mutualisées cette directive provoque une erreur 500.
# Chaque dossier de pages contient un index.html ; /_astro/ ne contient que des fichiers publics.

# --- Adresse unique et HTTPS obligatoire ------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.bernardaudsi.com -> bernardaudsi.com (une seule adresse pour Google), directement en HTTPS.
  RewriteCond %{HTTP_HOST} ^www\.bernardaudsi\.com$ [NC]
  RewriteRule ^ https://bernardaudsi.com%{REQUEST_URI} [L,R=301]
  # Tout le reste : HTTPS, sur le nom de domaine demandé.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- En-têtes de sécurité -------------------------------------------------------------
# Le site ne charge rien d'un tiers : la politique de contenu (CSP) n'autorise que lui-même,
# ni script ni style en ligne. Si une ressource externe est un jour ajoutée, elle doit être
# autorisée explicitement ici, après revue sécurité.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HSTS : à activer seulement une fois HTTPS vérifié sur le domaine (il est ensuite mémorisé par les
  # navigateurs). Commencer court : retirer le « # » de la ligne suivante. « includeSubDomains » est volontairement
  # absent : il imposerait HTTPS à tous les sous-domaines (messagerie, aperçu...), dont on ne connaît pas l'état.
  # Header always set Strict-Transport-Security "max-age=86400"
  # Après une semaine sans problème, passer à max-age=31536000 (un an).
  Header unset X-Powered-By
</IfModule>

# --- Fichiers cachés interdits (sauf .well-known) --------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

# --- Compression -----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- Cache -------------------------------------------------------------------------------
# Les fichiers de /_astro/ portent une empreinte dans leur nom : ils ne changent jamais.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
