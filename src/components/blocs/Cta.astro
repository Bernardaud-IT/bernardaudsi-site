---
import Icon from '../Icon.astro';
import Section from '../Section.astro';
import { lien } from '../../lib/site';

interface Props {
  titre: string;
  texte?: string;
  bouton: { libelle: string; href: string };
}
const { titre, texte, bouton } = Astro.props;
---

<Section fond="sombre">
  <div class="cta reveal">
    <h2>{titre}</h2>
    {texte && <p>{texte}</p>}
    <a class="btn btn-primary" href={lien(bouton.href)}>{bouton.libelle} <Icon nom="fleche" /></a>
  </div>
</Section>
