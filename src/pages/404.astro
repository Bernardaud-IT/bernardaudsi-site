---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import { lien, site } from '../lib/site';
---

<Base titre={`Page introuvable | ${site.nom}`} description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="page-hero on-dark">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Erreur 404</p>
        <h1>Page introuvable</h1>
        <p class="page-chapo">Cette page n'existe pas ou a été déplacée.</p>
      </div>
    </div>
  </section>
  <Section>
    <p>
      <a class="btn btn-primary" href={lien('/')}>Retour à l'accueil <Icon nom="fleche" /></a>
      <a class="btn btn-outline" href={lien('/plan-du-site/')}>Plan du site</a>
    </p>
  </Section>
</Base>
